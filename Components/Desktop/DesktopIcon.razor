@* A desktop icon. Double-click opens the registered app; can be dragged to a new spot. *@
@using Microsoft.AspNetCore.Components.Web

<div class="xp-desktop-icon @(Selected ? "selected" : "")"
     style="left:@(X.ToString("0", System.Globalization.CultureInfo.InvariantCulture))px; top:@(Y.ToString("0", System.Globalization.CultureInfo.InvariantCulture))px;"
     tabindex="0"
     @onmousedown="OnMouseDown"
     @onmousedown:stopPropagation="true"
     @onclick="OnSingleClick"
     @ondblclick="OnDoubleClick"
     @onclick:stopPropagation="true">
    <div class="xp-desktop-icon-image">
        @((MarkupString)Icon)
    </div>
    <div class="xp-desktop-icon-label">@Label</div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnStartDrag { get; set; }

    private async Task OnMouseDown(MouseEventArgs e)
    {
        await OnSelect.InvokeAsync();
        await OnStartDrag.InvokeAsync(e);
    }

    private async Task OnSingleClick() => await OnSelect.InvokeAsync();
    private async Task OnDoubleClick() => await OnOpen.InvokeAsync();
}
