@page "/"
@layout EmptyLayout
@using PersonalSite.Components.Desktop
@using PersonalSite.Components.Desktop.Apps
@using PersonalSite.Services
@inject WindowManager Manager
@inject BootService Boot
@inject SoundService Sound
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Justin Ridings</PageTitle>

@if (_isMobile && !_forceDesktop)
{
    <MobileFallback />
}
else if (_stage == Stage.Booting)
{
    <BootScreen OnComplete="OnBootComplete" />
}
else if (_stage == Stage.Login)
{
    <LoginScreen OnLogin="OnLogin" />
}
else
{
    <div class="xp-desktop @(_fadeIn ? "fade-in" : "")"
         @onmousedown="OnDesktopMouseDown"
         @oncontextmenu="OnDesktopRightClick"
         @oncontextmenu:preventDefault="true"
         @onmousemove="OnGlobalMove"
         @onmouseup="OnGlobalUp"
         @onkeydown="OnDesktopKey"
         tabindex="0"
         @ref="_rootRef">

        <div class="xp-desktop-icons">
            @foreach (var def in _icons)
            {
                <DesktopIcon Label="@def.Title"
                             Icon="@def.IconHtml"
                             Selected="@(_selectedIcon == def.Key)"
                             OnSelect="() => _selectedIcon = def.Key"
                             OnOpen="() => OpenApp(def.Key)" />
            }
        </div>

        <div class="xp-desktop-stickynote">
            <b>📝 TODO</b>
            <ul>
                <li>fix bug from 2019</li>
                <li>reply to recruiter</li>
                <li>maybe sleep</li>
            </ul>
        </div>

        @* Window host *@
        @foreach (var w in Manager.Windows)
        {
            @if (!w.IsMinimized)
            {
                <Window Win="w"
                        Manager="Manager"
                        Focused="@(w.Id == Manager.FocusedId)"
                        OnStartDrag="StartDrag"
                        OnStartResize="StartResize" />
            }
        }

        @if (_contextMenuOpen)
        {
            <ContextMenu X="_contextX" Y="_contextY"
                         OnRefresh="OnRefresh"
                         OnNewShortcut="OnNewShortcutJoke" />
        }

        @if (_snowOn)
        {
            <SnowEffect />
        }

        @if (_bsodOn)
        {
            <BsodScreen OnDismiss="DismissBsod" />
        }

        <Taskbar Manager="Manager" OnBsodRequested="ShowBsod" />

        @if (!string.IsNullOrEmpty(_toast))
        {
            <div class="xp-toast" @onclick="() => _toast = string.Empty">@_toast</div>
        }
    </div>
}

@code {
    enum Stage { Booting, Login, Desktop }

    private Stage _stage = Stage.Booting;
    private bool _isMobile;
    private bool _forceDesktop;
    private bool _fadeIn;
    private string? _selectedIcon;
    private bool _contextMenuOpen;
    private double _contextX, _contextY;
    private bool _snowOn;
    private bool _bsodOn;
    private string _toast = "";
    private System.Threading.Timer? _toastTimer;

    private string? _draggingId;
    private string? _resizingId;
    private double _dragOffX, _dragOffY;
    private double _resizeStartX, _resizeStartY, _resizeStartW, _resizeStartH;

    private readonly List<int> _konami = new();
    private static readonly string[] KonamiSeq =
        { "ArrowUp","ArrowUp","ArrowDown","ArrowDown","ArrowLeft","ArrowRight","ArrowLeft","ArrowRight","b","a" };

    private ElementReference _rootRef;
    private bool _focusOnNextRender;

    // The icons displayed on the desktop, in order.
    private List<AppDefinition> _icons => new[]
    {
        "my-computer", "about", "pe-inspector", "pong", "projects", "resume", "ie", "msn", "recycle-bin", "cmd"
    }.Select(k => Manager.Registry[k]).ToList();

    protected override async Task OnInitializedAsync()
    {
        // Register apps once.
        if (Manager.Registry.Count == 0)
        {
            Manager.Register(new("about",        "About Me",            "📄", typeof(AboutApp),        540, 480));
            Manager.Register(new("my-computer",  "My Computer",         "💻", typeof(MyComputerApp),   560, 420));
            Manager.Register(new("projects",     "Projects",            "📁", typeof(ProjectsApp),     560, 420));
            Manager.Register(new("resume",       "Resume.doc",          "📝", typeof(ResumeApp),       760, 560));
            Manager.Register(new("pong",         "Pong.exe",            "🏓", typeof(PongApp),         900, 700));
            Manager.Register(new("pe-inspector", "PE Inspector.exe",    "🔬", typeof(PEInspectorApp),  900, 640));
            Manager.Register(new("ie",           "Internet Explorer",   "🌐", typeof(IeApp),           640, 480));
            Manager.Register(new("msn",          "MSN Messenger",       "💬", typeof(MsnApp),          400, 520));
            Manager.Register(new("recycle-bin",  "Recycle Bin",         "🗑️", typeof(RecycleBinApp),   620, 420));
            Manager.Register(new("cmd",          "Command Prompt",      "⌨️", typeof(CmdApp),          640, 400));
        }

        // Mobile detection: ?force_desktop=1 always shows the desktop
        try
        {
            var width = await JS.InvokeAsync<int>("eval", "window.innerWidth");
            _isMobile = width < 768;
        }
        catch { _isMobile = false; }

        try
        {
            var qs = await JS.InvokeAsync<string>("eval", "window.location.search || ''");
            _forceDesktop = qs.Contains("force_desktop=1");
        }
        catch { }

        // Skip boot if we've already done it this session
        if (await Boot.HasBootedThisSessionAsync())
        {
            _stage = Stage.Desktop;
            _fadeIn = true;
        }

        _focusOnNextRender = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusOnNextRender)
        {
            _focusOnNextRender = false;
            try { await _rootRef.FocusAsync(); } catch { }
        }
    }

    private async Task OnBootComplete()
    {
        _stage = Stage.Login;
        _focusOnNextRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnLogin()
    {
        _stage = Stage.Desktop;
        _fadeIn = true;
        await Boot.MarkBootedAsync();
        _ = Sound.StartupAsync();
        _focusOnNextRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenApp(string key)
    {
        Manager.Open(key);
        _ = Sound.ClickAsync();
    }

    private void OnDesktopMouseDown()
    {
        _selectedIcon = null;
        _contextMenuOpen = false;
    }

    private void OnDesktopRightClick(MouseEventArgs e)
    {
        _contextX = e.ClientX;
        _contextY = e.ClientY;
        _contextMenuOpen = true;
    }

    private void OnRefresh()
    {
        _contextMenuOpen = false;
        ShowToast("Refreshed.");
    }

    private void OnNewShortcutJoke()
    {
        _contextMenuOpen = false;
        ShowToast("You can't make new things on a fake desktop. Sorry!");
    }

    private void OnDesktopKey(KeyboardEventArgs e)
    {
        // BSOD via Ctrl+Alt+Del
        if (e.CtrlKey && e.AltKey && (e.Key == "Delete" || e.Key == "Del"))
        {
            ShowBsod();
            return;
        }

        // Konami code
        var key = e.Key;
        var expected = KonamiSeq[_konami.Count];
        if (string.Equals(key, expected, StringComparison.OrdinalIgnoreCase))
        {
            _konami.Add(0);
            if (_konami.Count == KonamiSeq.Length)
            {
                _konami.Clear();
                _snowOn = !_snowOn;
                ShowToast(_snowOn ? "❄ Konami activated. ❄" : "Snow off.");
            }
        }
        else
        {
            _konami.Clear();
        }
    }

    private void ShowBsod()
    {
        _bsodOn = true;
        _ = Sound.ErrorAsync();
    }

    private void DismissBsod() => _bsodOn = false;

    private void StartDrag(string id)
    {
        var w = Manager.Windows.FirstOrDefault(w => w.Id == id);
        if (w is null) return;
        _draggingId = id;
        _dragOffX = _lastMouseX - w.X;
        _dragOffY = _lastMouseY - w.Y;
    }

    private void StartResize(string id)
    {
        var w = Manager.Windows.FirstOrDefault(w => w.Id == id);
        if (w is null) return;
        _resizingId = id;
        _resizeStartX = _lastMouseX;
        _resizeStartY = _lastMouseY;
        _resizeStartW = w.Width;
        _resizeStartH = w.Height;
    }

    private double _lastMouseX, _lastMouseY;

    private void OnGlobalMove(MouseEventArgs e)
    {
        _lastMouseX = e.ClientX;
        _lastMouseY = e.ClientY;

        if (_draggingId is not null)
        {
            Manager.Move(_draggingId, e.ClientX - _dragOffX, e.ClientY - _dragOffY);
        }
        else if (_resizingId is not null)
        {
            Manager.Resize(_resizingId,
                _resizeStartW + (e.ClientX - _resizeStartX),
                _resizeStartH + (e.ClientY - _resizeStartY));
        }
    }

    private void OnGlobalUp()
    {
        _draggingId = null;
        _resizingId = null;
    }

    private void ShowToast(string msg)
    {
        _toast = msg;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ =>
        {
            _toast = "";
            InvokeAsync(StateHasChanged);
        }, null, 2500, Timeout.Infinite);
    }

    public ValueTask DisposeAsync()
    {
        _toastTimer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
