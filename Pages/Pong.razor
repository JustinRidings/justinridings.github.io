@page "/pong"
@implements IAsyncDisposable

<PageTitle>Pong</PageTitle>

<MudPaper Class="pong-container pa-4" Elevation="3">
    <div class="pong-scoreboard">
        <MudText Typo="Typo.h5">YOU: @playerScore</MudText>
        <MudText Typo="Typo.h5">|</MudText>
        <MudText Typo="Typo.h5">BOT: @botScore</MudText>
    </div>

    <div class="pong-arena"
         tabindex="0"
         @ref="arenaRef"
         @onmousemove="OnMouseMove"
         @onkeydown="OnKeyDown"
         @onkeydown:preventDefault="true">

        <div class="pong-centerline"></div>
        <div class="pong-paddle pong-paddle--left" style="top:@((int)playerY)px;"></div>
        <div class="pong-paddle pong-paddle--right" style="top:@((int)botY)px;"></div>
        <div class="pong-ball" style="left:@((int)ballX)px; top:@((int)ballY)px;"></div>

        @if (gameState == GameState.Idle)
        {
            <div class="pong-overlay">
                <MudText Typo="Typo.h4">PONG</MudText>
                <p>Move with mouse, W/S, or ↑/↓ &nbsp;·&nbsp; Space to pause</p>
                <p>First to @WinningScore wins.</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartGame">Start Game</MudButton>
            </div>
        }
        else if (gameState == GameState.Paused)
        {
            <div class="pong-overlay">
                <MudText Typo="Typo.h4">Paused</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TogglePause">Resume</MudButton>
            </div>
        }
        else if (gameState == GameState.GameOver)
        {
            <div class="pong-overlay">
                <MudText Typo="Typo.h4">@(playerScore > botScore ? "You Win! 🏆" : "Bot Wins 🤖")</MudText>
                <p>Final score: @playerScore – @botScore</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartGame">Play Again</MudButton>
            </div>
        }
    </div>

    <div class="pong-controls">
        <MudText Typo="Typo.body1">Difficulty:</MudText>
        @foreach (var d in Enum.GetValues<Difficulty>())
        {
            <MudButton Variant="@(difficulty == d ? Variant.Filled : Variant.Outlined)"
                       Color="@(difficulty == d ? Color.Primary : Color.Default)"
                       OnClick="() => SetDifficulty(d)">@d</MudButton>
        }
        @if (gameState is GameState.Playing or GameState.Paused)
        {
            <MudButton Variant="Variant.Outlined" OnClick="TogglePause">@(gameState == GameState.Paused ? "Resume" : "Pause")</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ResetGame">Reset</MudButton>
        }
    </div>
</MudPaper>

@code {
    private const float ArenaWidth = 800;
    private const float ArenaHeight = 500;
    private const float PaddleWidth = 12;
    private const float PaddleHeight = 100;
    private const float BallSize = 16;
    private const float PaddleOffsetX = 20;
    private const float KeyboardStep = 24;
    private const float MaxBallSpeed = 12f;
    private const int WinningScore = 7;
    private const int FrameMs = 16;

    private enum GameState { Idle, Playing, Paused, GameOver }
    private enum Difficulty { Easy, Medium, Hard }

    private GameState gameState = GameState.Idle;
    private Difficulty difficulty = Difficulty.Medium;

    private float playerY = (ArenaHeight - PaddleHeight) / 2f;
    private float botY = (ArenaHeight - PaddleHeight) / 2f;
    private float ballX = (ArenaWidth - BallSize) / 2f;
    private float ballY = (ArenaHeight - BallSize) / 2f;
    private float ballVx = 5f;
    private float ballVy = 3f;

    private int playerScore;
    private int botScore;

    private System.Timers.Timer? loop;
    private ElementReference arenaRef;
    private bool focusOnNextRender;

    protected override void OnInitialized()
    {
        loop = new System.Timers.Timer(FrameMs);
        loop.Elapsed += (_, _) => InvokeAsync(Tick);
        loop.AutoReset = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusOnNextRender)
        {
            focusOnNextRender = false;
            try { await arenaRef.FocusAsync(); } catch { /* ignore */ }
        }
    }

    private void StartGame()
    {
        playerScore = 0;
        botScore = 0;
        ResetBall(toPlayer: Random.Shared.Next(2) == 0);
        gameState = GameState.Playing;
        focusOnNextRender = true;
        loop?.Start();
    }

    private void TogglePause()
    {
        if (gameState == GameState.Playing)
        {
            gameState = GameState.Paused;
            loop?.Stop();
        }
        else if (gameState == GameState.Paused)
        {
            gameState = GameState.Playing;
            focusOnNextRender = true;
            loop?.Start();
        }
    }

    private void ResetGame()
    {
        loop?.Stop();
        gameState = GameState.Idle;
        playerScore = 0;
        botScore = 0;
        ResetBall();
    }

    private void SetDifficulty(Difficulty d) => difficulty = d;

    private void Tick()
    {
        if (gameState != GameState.Playing) return;

        ballX += ballVx;
        ballY += ballVy;

        if (ballY <= 0)
        {
            ballY = 0;
            ballVy = MathF.Abs(ballVy);
        }
        else if (ballY >= ArenaHeight - BallSize)
        {
            ballY = ArenaHeight - BallSize;
            ballVy = -MathF.Abs(ballVy);
        }

        var playerPaddleRight = PaddleOffsetX + PaddleWidth;
        var botPaddleLeft = ArenaWidth - PaddleOffsetX - PaddleWidth;

        if (ballVx < 0
            && ballX <= playerPaddleRight
            && ballX + BallSize >= PaddleOffsetX
            && ballY + BallSize >= playerY
            && ballY <= playerY + PaddleHeight)
        {
            ballX = playerPaddleRight;
            BounceOffPaddle(playerY);
        }
        else if (ballVx > 0
            && ballX + BallSize >= botPaddleLeft
            && ballX <= botPaddleLeft + PaddleWidth
            && ballY + BallSize >= botY
            && ballY <= botY + PaddleHeight)
        {
            ballX = botPaddleLeft - BallSize;
            BounceOffPaddle(botY);
        }

        MoveBot();

        if (ballX + BallSize < 0)
        {
            botScore++;
            CheckWinOrReset(toPlayer: true);
        }
        else if (ballX > ArenaWidth)
        {
            playerScore++;
            CheckWinOrReset(toPlayer: false);
        }

        StateHasChanged();
    }

    private void BounceOffPaddle(float paddleY)
    {
        ballVx = -ballVx;
        ballVx = Math.Clamp(ballVx * 1.05f, -MaxBallSpeed, MaxBallSpeed);

        var ballCenter = ballY + BallSize / 2f;
        var paddleCenter = paddleY + PaddleHeight / 2f;
        var hitOffset = (ballCenter - paddleCenter) / (PaddleHeight / 2f);
        ballVy = Math.Clamp(hitOffset, -1f, 1f) * 6f;
    }

    private void MoveBot()
    {
        var (speed, deadZone) = difficulty switch
        {
            Difficulty.Easy => (3.5f, 30f),
            Difficulty.Medium => (5.5f, 12f),
            Difficulty.Hard => (8f, 4f),
            _ => (5.5f, 12f),
        };

        var ballCenter = ballY + BallSize / 2f;
        var botCenter = botY + PaddleHeight / 2f;
        var diff = ballCenter - botCenter;

        if (Math.Abs(diff) > deadZone)
        {
            botY += Math.Sign(diff) * speed;
        }
        botY = Math.Clamp(botY, 0, ArenaHeight - PaddleHeight);
    }

    private void CheckWinOrReset(bool toPlayer)
    {
        if (playerScore >= WinningScore || botScore >= WinningScore)
        {
            gameState = GameState.GameOver;
            loop?.Stop();
        }
        else
        {
            ResetBall(toPlayer);
        }
    }

    private void ResetBall(bool toPlayer = false)
    {
        ballX = (ArenaWidth - BallSize) / 2f;
        ballY = (ArenaHeight - BallSize) / 2f;
        ballVx = (toPlayer ? -1 : 1) * 5f;
        ballVy = (Random.Shared.Next(2) == 0 ? -1 : 1) * 3f;
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        var y = (float)e.OffsetY - PaddleHeight / 2f;
        playerY = Math.Clamp(y, 0, ArenaHeight - PaddleHeight);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "w":
            case "W":
            case "ArrowUp":
                playerY = Math.Clamp(playerY - KeyboardStep, 0, ArenaHeight - PaddleHeight);
                break;
            case "s":
            case "S":
            case "ArrowDown":
                playerY = Math.Clamp(playerY + KeyboardStep, 0, ArenaHeight - PaddleHeight);
                break;
            case " ":
                if (gameState is GameState.Playing or GameState.Paused)
                    TogglePause();
                break;
        }
    }

    public ValueTask DisposeAsync()
    {
        if (loop is not null)
        {
            loop.Stop();
            loop.Dispose();
            loop = null;
        }
        return ValueTask.CompletedTask;
    }
}
